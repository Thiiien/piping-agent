<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PipingAgent.Tools\PipingAgent.Tools.csproj" />
    <ProjectReference Include="..\PipingAgent.Hosting\PipingAgent.Hosting.csproj" />
    <ProjectReference Include="..\PipingAgent.Dxf\PipingAgent.Dxf.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
