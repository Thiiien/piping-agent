{
  "id": "generic_box",
  "name": "Hộp bao dự phòng cho loại chưa có định nghĩa",
  "schemaVersion": "1.0",
  "params": [
    { "name": "L", "unit": "mm", "from": "footprint.length" },
    { "name": "W", "unit": "mm", "from": "footprint.width" },
    { "name": "H", "unit": "mm", "from": "tag", "pattern": "H\\s*=\\s*(?<v>\\d+(?:\\.\\d+)?)", "default": 2000 }
  ],
  "body": [
    { "shape": "box", "size": ["L", "W", "H"], "center": [0, 0, "H / 2"] }
  ],
  "nozzles": [],
  "hosts": { "autocad": { "block3d": null } }
}
